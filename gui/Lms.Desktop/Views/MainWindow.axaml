<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lms.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Lms.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Icon="/Assets/avalonia-logo.ico"
        Title="Lms.Desktop">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <StackPanel Margin="24" Spacing="8">
        <TextBlock Text="{Binding LibraryName}" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="{Binding BookCount}" Opacity="0.6" />
        <TextBlock Text="{Binding DatabaseStatus}" Opacity="0.6" />
    </StackPanel>

</Window>