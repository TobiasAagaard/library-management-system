<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lms.Desktop.ViewModels"
        xmlns:models="using:Lms.Application.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Lms.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Lms.Desktop">

    <DockPanel Margin="20" LastChildFill="True">

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding Library.Name}"
                   FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,10" />

        <StackPanel Spacing="8" Width="400" HorizontalAlignment="Left">
            <TextBlock Text="New book" FontWeight="SemiBold" />
            <TextBox PlaceholderText="Title" Text="{Binding NewBookTitle}" />
            <TextBox PlaceholderText="ISBN" Text="{Binding NewBookIsbn}" />
            <Grid ColumnDefinitions="*,8,*">
                <TextBox Grid.Column="0" PlaceholderText="Author first name" Text="{Binding NewAuthorFirstName}" />
                <TextBox Grid.Column="2" PlaceholderText="Author last name" Text="{Binding NewAuthorLastName}" />
            </Grid>
            <Button Content="Add book"
                    HorizontalAlignment="Right"
                    Command="{Binding AddBookCommand}" />
        </StackPanel>


        <TextBlock DockPanel.Dock="Top" Text="Books" FontWeight="SemiBold" Margin="0,0,0,6" />

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Books}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Book">
                        <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="4,6">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ISBN}" Opacity="0.7" FontSize="12" />
                                <ItemsControl ItemsSource="{Binding Authors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Author">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" Opacity="0.7" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</Window>
